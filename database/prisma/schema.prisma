datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ORGANIZATIONS & MULTI-TENANCY
// -----------------------------------------------------------------------------

model Organization {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  legalName     String?
  taxIdentifier String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  branches      OrganizationBranch[]
  memberships   OrganizationMembership[]
  roles         Role[]
  sessions      Session[]
  auditLogs     AuditLog[]
  outboxEvents  OutboxEvent[]
  leads         Lead[]
  leadActivities LeadActivity[]
  leadStatusHistories LeadStatusHistory[]
  customers     Customer[]
  customerContacts CustomerContact[]
  customerAddresses CustomerAddress[]
  customerSites CustomerSite[]
  surveys       Survey[]
  surveyRevisions SurveyRevision[]
  surveyPhotos  SurveyPhoto[]
  productCategories ProductCategory[]
  manufacturers Manufacturer[]
  products      Product[]
  productVariants ProductVariant[]
  productAttributeDefinitions ProductAttributeDefinition[]
  productAttributeValues ProductAttributeValue[]
  productPriceHistories ProductPriceHistory[]
  invitations   OrganizationInvitation[]

  // Phase 2: Engineering, BOM, Quotation, Contracts, Sales Orders
  documentSequences           DocumentSequence[]
  engineeringDesigns          EngineeringDesign[]
  engineeringDesignRevisions  EngineeringDesignRevision[]
  calculationRuns             CalculationRun[]
  boms                        BillOfMaterials[]
  bomItems                    BOMItem[]
  taxConfigurations           TaxConfiguration[]
  costEstimates               CostEstimate[]
  quotations                  Quotation[]
  quotationVersions           QuotationVersion[]
  quotationItems              QuotationItem[]
  contracts                   Contract[]
  contractPaymentMilestones   ContractPaymentMilestone[]
  salesOrders                 SalesOrder[]
  salesOrderMilestones        SalesOrderMilestone[]
  projectInitiations          ProjectInitiation[]

  // Phase 3: Procurement, Supplier Management, PO, GRN & Serials
  suppliers                   Supplier[]
  supplierContacts            SupplierContact[]
  supplierAddresses           SupplierAddress[]
  supplierBankAccounts        SupplierBankAccount[]
  supplierDocuments           SupplierDocument[]
  supplierProductMappings     SupplierProductMapping[]
  supplierPriceHistories      SupplierPriceHistory[]
  materialRequirements        MaterialRequirement[]
  materialRequirementLines    MaterialRequirementLine[]
  purchaseRequisitions        PurchaseRequisition[]
  purchaseRequisitionLines    PurchaseRequisitionLine[]
  rfqs                        RFQ[]
  rfqLines                    RFQLine[]
  rfqSuppliers                RFQSupplier[]
  supplierQuotations          SupplierQuotation[]
  supplierQuotationLines      SupplierQuotationLine[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderLines          PurchaseOrderLine[]
  purchaseDeliverySchedules   PurchaseDeliverySchedule[]
  goodsReceiptNotes           GoodsReceiptNote[]
  goodsReceiptLines           GoodsReceiptLine[]
  qualityInspections          QualityInspection[]
  productSerials              ProductSerial[]
  inventoryLocations          InventoryLocation[]
  inventoryReceiptMovements   InventoryReceiptMovement[]
  supplierReturns             SupplierReturn[]
  supplierReturnLines         SupplierReturnLine[]

  @@map("organizations")
}

model OrganizationBranch {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  address        String?
  city           String
  state          String
  postalCode     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    OrganizationMembership[]
  leads          Lead[]
  invitations    OrganizationInvitation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("organization_branches")
}

// -----------------------------------------------------------------------------
// IDENTITY & USERS
// -----------------------------------------------------------------------------

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String?
  firstName              String
  lastName               String
  phone                  String?
  status                 String    @default("ACTIVE") // INVITED, PENDING_VERIFICATION, ACTIVE, SUSPENDED, ARCHIVED
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[]  @default([])
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  isActive               Boolean   @default(true)
  isSuperAdmin           Boolean   @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  memberships            OrganizationMembership[]
  sessions               Session[]
  auditLogs              AuditLog[]
  assignedLeads          Lead[]                   @relation("LeadAssignedTo")
  leadActivities         LeadActivity[]
  assignedSurveys        Survey[]                 @relation("SurveyTechnician")
  surveyRevisions        SurveyRevision[]
  surveyPhotos           SurveyPhoto[]
  priceHistories         ProductPriceHistory[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations        OrganizationInvitation[] @relation("InvitationSender")

  // Phase 2 Relations
  createdDesigns         EngineeringDesign[]         @relation("DesignCreatedBy")
  approvedDesigns        EngineeringDesign[]         @relation("DesignApprovedBy")
  createdDesignRevisions EngineeringDesignRevision[] @relation("RevisionCreatedBy")
  calculationRuns        CalculationRun[]            @relation("CalculationRunExecutedBy")
  createdBOMs            BillOfMaterials[]           @relation("BOMCreatedBy")
  approvedBOMs           BillOfMaterials[]           @relation("BOMApprovedBy")
  createdQuotations      Quotation[]                 @relation("QuotationCreatedBy")
  approvedQuotations     Quotation[]                 @relation("QuotationApprovedBy")
  createdQuotationVersions QuotationVersion[]        @relation("QuotationVersionCreatedBy")
  createdContracts       Contract[]                  @relation("ContractCreatedBy")
  createdSalesOrders     SalesOrder[]                @relation("SalesOrderCreatedBy")
  confirmedSalesOrders   SalesOrder[]                @relation("SalesOrderConfirmedBy")
  initiatedProjects      ProjectInitiation[]         @relation("ProjectInitiatedBy")

  // Phase 3 Relations
  supplierPriceChanges        SupplierPriceHistory[]      @relation("PriceChangedBy")
  createdMaterialRequirements MaterialRequirement[]       @relation("RequirementCreatedBy")
  createdRequisitions         PurchaseRequisition[]       @relation("RequisitionRequestedBy")
  approvedRequisitions        PurchaseRequisition[]       @relation("RequisitionApprovedBy")
  createdRFQs                 RFQ[]                       @relation("RFQCreatedBy")
  createdPurchaseOrders       PurchaseOrder[]             @relation("POCreatedBy")
  approvedPurchaseOrders      PurchaseOrder[]             @relation("POApprovedBy")
  receivedGRNs                GoodsReceiptNote[]          @relation("GRNReceivedBy")
  performedInspections        QualityInspection[]         @relation("InspectionPerformedBy")
  registeredSerials           ProductSerial[]             @relation("SerialRegisteredBy")
  createdMovements            InventoryReceiptMovement[]  @relation("MovementCreatedBy")
  createdSupplierReturns      SupplierReturn[]            @relation("ReturnCreatedBy")

  @@map("users")
}

model OrganizationMembership {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  branchId       String?
  isActive       Boolean   @default(true)
  joinedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch         OrganizationBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([branchId])
  @@map("organization_memberships")
}

// -----------------------------------------------------------------------------
// RBAC: ROLES & PERMISSIONS
// -----------------------------------------------------------------------------

model Role {
  id             String   @id @default(uuid())
  organizationId String?  // NULL = Global System Role; Non-null = Tenant custom role
  name           String
  code           String
  description    String?
  scope          String   @default("ORGANIZATION") // NONE, OWN, ASSIGNED, TEAM, BRANCH, ORGANIZATION
  category       String   @default("BUSINESS") // SYSTEM, BUSINESS, CUSTOM
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    MembershipRole[]
  permissions    RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String
  action      String   @default("READ") // READ, CREATE, UPDATE, DELETE, APPROVE, REJECT, ASSIGN, EXPORT, MANAGE
  resource    String   @default("all")
  sensitivity String   @default("NORMAL") // NORMAL, SENSITIVE, CRITICAL
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@index([category])
  @@map("permissions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model OrganizationInvitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  roleCode       String    @default("SOLAR_ENGINEER")
  branchId       String?
  tokenHash      String    @unique
  invitedById    String?
  status         String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?               @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  branch         OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@map("organization_invitations")
}

model MembershipRole {
  id           String   @id @default(uuid())
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())

  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
  @@map("membership_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// SESSIONS & AUTHENTICATION
// -----------------------------------------------------------------------------

model Session {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// AUDIT LOGGING
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// TRANSACTIONAL OUTBOX PATTERN
// -----------------------------------------------------------------------------

model OutboxEvent {
  id             String    @id @default(uuid())
  organizationId String
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         String    @default("PENDING") // PENDING, PROCESSING, PUBLISHED, FAILED
  retryCount     Int       @default(0)
  scheduledFor   DateTime  @default(now())
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([organizationId])
  @@index([eventType])
  @@map("outbox_events")
}

// -----------------------------------------------------------------------------
// IDEMPOTENCY RECORD
// -----------------------------------------------------------------------------

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  organizationId String
  userId         String?
  endpoint       String
  requestHash    String
  responseCode   Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([idempotencyKey])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// =============================================================================
// PHASE 1: CRM & LEAD MANAGEMENT
// =============================================================================

model Lead {
  id                    String              @id @default(uuid())
  organizationId        String
  branchId              String?
  leadNumber            String
  firstName             String
  lastName              String
  email                 String?
  phone                 String
  alternatePhone        String?
  address               String?
  city                  String
  state                 String
  postalCode            String?
  source                String              @default("WEBSITE") // WEBSITE, REFERRAL, COLD_CALL, CAMPAIGN, WALK_IN, OTHER
  status                String              @default("NEW")     // NEW, CONTACTED, QUALIFIED, SURVEY_PENDING, PROPOSAL_PENDING, NEGOTIATION, WON, LOST
  systemType            String              @default("ON_GRID") // ON_GRID, OFF_GRID, HYBRID
  estimatedMonthlyBill  Decimal?            @db.Decimal(12, 2)
  estimatedRoofAreaSqFt Decimal?            @db.Decimal(10, 2)
  estimatedCapacityKw   Decimal?            @db.Decimal(8, 2)
  budget                Decimal?            @db.Decimal(12, 2)
  score                 Int                 @default(50)
  lostReason            String?
  qualificationDetails  Json?
  notes                 String?
  assignedToId          String?
  convertedCustomerId   String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedTo            User?               @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedCustomer     Customer?           @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  activities            LeadActivity[]
  statusHistory         LeadStatusHistory[]
  surveys               Survey[]

  @@unique([organizationId, leadNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([assignedToId])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("leads")
}

model LeadActivity {
  id             String       @id @default(uuid())
  organizationId String
  leadId         String
  userId         String?
  type           String       // NOTE, CALL, EMAIL, MEETING, STATUS_CHANGE
  summary        String
  details        String?
  scheduledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([userId])
  @@map("lead_activities")
}

model LeadStatusHistory {
  id             String       @id @default(uuid())
  organizationId String
  leadId         String
  fromStatus     String
  toStatus       String
  changedById    String?
  reason         String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@map("lead_status_history")
}

// =============================================================================
// PHASE 1: CUSTOMER MANAGEMENT & CUSTOMER 360
// =============================================================================

model Customer {
  id             String            @id @default(uuid())
  organizationId String
  customerNumber String
  customerType   String            @default("INDIVIDUAL") // INDIVIDUAL, COMMERCIAL, INSTITUTIONAL
  name           String
  email          String?
  phone          String
  alternatePhone String?
  taxId          String?           // GSTIN / PAN / VAT
  status         String            @default("ACTIVE")    // ACTIVE, INACTIVE, BLACKLISTED
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  convertedLead  Lead?             @relation("LeadConvertedCustomer")
  contacts       CustomerContact[]
  addresses      CustomerAddress[]
  sites          CustomerSite[]
  surveys        Survey[]

  // Phase 2 Relations
  engineeringDesigns EngineeringDesign[]
  quotations         Quotation[]
  contracts          Contract[]
  salesOrders        SalesOrder[]
  projectInitiations ProjectInitiation[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@map("customers")
}

model CustomerContact {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String
  name           String
  designation    String?
  email          String?
  phone          String
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerAddress {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String
  type           String       @default("BILLING") // BILLING, SITE, COMMUNICATION
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  postalCode     String
  country        String       @default("India")
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerSite {
  id                         String       @id @default(uuid())
  organizationId             String
  customerId                 String
  siteName                   String
  addressLine1               String
  addressLine2               String?
  landmark                   String?
  city                       String
  state                      String
  postalCode                 String
  latitude                   Decimal?     @db.Decimal(10, 7)
  longitude                  Decimal?     @db.Decimal(10, 7)
  electricityConnectionNumber String?
  sanctionedLoadKw           Decimal?     @db.Decimal(8, 2)
  tariffCategory             String?
  discomName                 String?
  transformerCapacityKva     Decimal?     @db.Decimal(8, 2)
  meterNumber                String?
  averageMonthlyUnits        Decimal?     @db.Decimal(10, 2)
  roofAreaSqFt               Decimal?     @db.Decimal(10, 2)
  roofType                   String?      // RCC_FLAT, METAL_SHEET, TILED, SHED, GROUND
  buildingHeightFloors       Int?         @default(1)
  shadowFreeAreaSqFt         Decimal?     @db.Decimal(10, 2)
  notes                      String?
  status                     String       @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  surveys                    Survey[]

  // Phase 2 Relations
  engineeringDesigns         EngineeringDesign[]
  quotations                 Quotation[]
  projectInitiations         ProjectInitiation[]

  @@index([organizationId])
  @@index([customerId])
  @@map("customer_sites")
}

// =============================================================================
// PHASE 1: SITE SURVEY & ASSESSMENT
// =============================================================================

model Survey {
  id                         String           @id @default(uuid())
  organizationId             String
  surveyNumber               String
  customerId                 String
  siteId                     String
  leadId                     String?
  assignedTechnicianId       String?
  scheduledDate              DateTime?
  completedDate              DateTime?
  status                     String           @default("REQUESTED") // REQUESTED, SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, APPROVED, REVISION_REQUESTED
  rejectionReason            String?
  currentRevisionNumber      Int              @default(1)

  // Technical Assessment Data
  roofType                   String?
  roofAgeYears               Int?
  roofPitchDegrees           Decimal?         @db.Decimal(5, 2)
  roofAzimuthDegrees         Decimal?         @db.Decimal(5, 2)
  roofCondition              String?          // EXCELLENT, GOOD, FAIR, POOR
  usableAreaSqFt             Decimal?         @db.Decimal(10, 2)
  shadowObstacles            String?          // PARAPET_WALL, TREES, WATER_TANK, NEIGHBOR_BUILDING, NONE, OTHER
  recommendedCapacityKw      Decimal?         @db.Decimal(8, 2)

  sanctionedLoadKw           Decimal?         @db.Decimal(8, 2)
  currentVoltage             Decimal?         @db.Decimal(6, 2)
  phaseType                  String?          @default("THREE_PHASE") // SINGLE_PHASE, THREE_PHASE
  incomingCableCapacitySqMm  Decimal?         @db.Decimal(6, 2)
  cableLengthMeters          Decimal?         @db.Decimal(8, 2)
  earthingRequired           Boolean          @default(true)
  earthResistanceOhms        Decimal?         @db.Decimal(6, 2)
  lightningArresterRequired  Boolean          @default(true)
  mainSwitchboardCondition   String?
  inverterLocation           String?          @default("INDOOR") // INDOOR, OUTDOOR, ROOF_TOP, BASEMENT
  distanceToMainPanelMeters  Decimal?         @db.Decimal(8, 2)

  accessibilityNotes         String?
  craneRequired              Boolean          @default(false)
  ladderRequired             Boolean          @default(false)
  storageAvailableOnSite     Boolean          @default(true)
  canSupportStructure        Boolean          @default(true)
  reinforcementRequired      Boolean          @default(false)
  remarks                    String?

  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  organization               Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site                       CustomerSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  lead                       Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTechnician         User?            @relation("SurveyTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  revisions                  SurveyRevision[]
  photos                     SurveyPhoto[]

  // Phase 2 Relations
  engineeringDesigns         EngineeringDesign[]

  @@unique([organizationId, surveyNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([siteId])
  @@index([assignedTechnicianId])
  @@index([status])
  @@map("surveys")
}

model SurveyRevision {
  id             String       @id @default(uuid())
  organizationId String
  surveyId       String
  revisionNumber Int
  changesSummary String?
  dataSnapshot   Json
  createdById    String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  survey         Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([surveyId, revisionNumber])
  @@index([organizationId])
  @@index([surveyId])
  @@map("survey_revisions")
}

model SurveyPhoto {
  id               String       @id @default(uuid())
  organizationId   String
  surveyId         String
  category         String       // ROOF, METER, MAIN_SWITCHBOARD, INVERTER_LOCATION, OBSTACLE, STRUCTURE, HAZARD, OTHER
  objectKey        String
  originalFileName String
  mimeType         String
  fileSize         Int
  caption          String?
  uploadedById     String?
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  survey           Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  uploadedBy       User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([surveyId])
  @@map("survey_photos")
}

// =============================================================================
// PHASE 1: SOLAR PRODUCT CATALOG
// =============================================================================

model ProductCategory {
  id             String                       @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  icon           String?
  isActive       Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  attributes     ProductAttributeDefinition[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("product_categories")
}

model Manufacturer {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  country        String?
  website        String?
  supportEmail   String?
  supportPhone   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("manufacturers")
}

model Product {
  id              String                  @id @default(uuid())
  organizationId  String
  categoryId      String
  manufacturerId  String
  code            String
  name            String
  modelNumber     String
  description     String?
  type            String                  // PANEL, INVERTER, BATTERY, STRUCTURE, CABLE, ACCESSORY
  warrantyYears   Int                     @default(5)
  datasheetUrl    String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer    Manufacturer            @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([type])
  @@map("products")
}

model ProductVariant {
  id                 String                @id @default(uuid())
  organizationId     String
  productId          String
  sku                String
  name               String
  ratedCapacityWatts Decimal?              @db.Decimal(10, 2)
  systemVoltage      Decimal?              @db.Decimal(8, 2)
  costPrice          Decimal               @db.Decimal(12, 2)
  sellingPrice       Decimal               @db.Decimal(12, 2)
  currency           String                @default("INR")
  isDefault          Boolean               @default(false)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product            Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory       ProductPriceHistory[]

  // Phase 2 Relations
  designPanels       EngineeringDesignRevision[] @relation("DesignPanelVariant")
  designInverters    EngineeringDesignRevision[] @relation("DesignInverterVariant")
  designBatteries    EngineeringDesignRevision[] @relation("DesignBatteryVariant")
  designStructures   EngineeringDesignRevision[] @relation("DesignStructureVariant")
  bomItems           BOMItem[]

  // Phase 3 Relations
  supplierMappings            SupplierProductMapping[]
  supplierPriceHistories      SupplierPriceHistory[]
  materialRequirementLines    MaterialRequirementLine[]
  requisitionLines            PurchaseRequisitionLine[]
  rfqLines                    RFQLine[]
  quotationLines              SupplierQuotationLine[]
  purchaseOrderLines          PurchaseOrderLine[]
  goodsReceiptLines           GoodsReceiptLine[]
  qualityInspections          QualityInspection[]
  serials                     ProductSerial[]
  inventoryMovements          InventoryReceiptMovement[]
  supplierReturnLines         SupplierReturnLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([productId])
  @@map("product_variants")
}

model ProductAttributeDefinition {
  id             String                  @id @default(uuid())
  organizationId String
  categoryId     String
  name           String
  code           String
  dataType       String                  // STRING, NUMBER, BOOLEAN, SELECT
  unit           String?
  isRequired     Boolean                 @default(false)
  options        Json?
  createdAt      DateTime                @default(now())

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values         ProductAttributeValue[]

  @@unique([organizationId, categoryId, code])
  @@index([organizationId])
  @@index([categoryId])
  @@map("product_attribute_definitions")
}

model ProductAttributeValue {
  id                    String                     @id @default(uuid())
  organizationId        String
  productId             String
  attributeDefinitionId String
  valueString           String?
  valueNumber           Decimal?                   @db.Decimal(12, 4)
  valueBoolean          Boolean?

  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product               Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeDefinitionId])
  @@index([organizationId])
  @@index([productId])
  @@index([attributeDefinitionId])
  @@map("product_attribute_values")
}

model ProductPriceHistory {
  id             String         @id @default(uuid())
  organizationId String
  variantId      String
  costPrice      Decimal        @db.Decimal(12, 2)
  sellingPrice   Decimal        @db.Decimal(12, 2)
  effectiveFrom  DateTime       @default(now())
  effectiveTo    DateTime?
  changedById    String?
  reason         String?
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedBy      User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([variantId])
  @@map("product_price_history")
}

// =============================================================================
// PHASE 2: DOCUMENT SEQUENCES & NUMBERING
// =============================================================================

model DocumentSequence {
  id             String       @id @default(uuid())
  organizationId String
  entityType     String       // DESIGN, BOM, QUOTATION, CONTRACT, SALES_ORDER, PROJECT
  prefix         String       // DES, BOM, QTN, CON, SO, PRJ
  year           Int
  lastNumber     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, prefix, year])
  @@index([organizationId])
  @@map("document_sequences")
}

// =============================================================================
// PHASE 2: SOLAR ENGINEERING & DESIGN STANDARDS REGISTRY
// =============================================================================

model EngineeringStandard {
  id                      String   @id @default(uuid())
  code                    String   @unique
  name                    String
  issuingBody             String   // MNRE, BIS, CEA, IEC
  category                String   // ELECTRICAL, MECHANICAL, SAFETY, GRID
  version                 String
  minDcAcRatio            Decimal? @db.Decimal(4, 2)
  maxDcAcRatio            Decimal? @db.Decimal(4, 2)
  maxDcVoltageSinglePhase Decimal? @db.Decimal(6, 2)
  maxDcVoltageThreePhase  Decimal? @db.Decimal(6, 2)
  voltageDropLimitPercent Decimal? @db.Decimal(4, 2)
  specifications          Json?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("engineering_standards")
}

// =============================================================================
// PHASE 2: SOLAR ENGINEERING DESIGNS & REVISIONS
// =============================================================================

model EngineeringDesign {
  id                   String                      @id @default(uuid())
  organizationId       String
  designNumber         String
  customerId           String
  siteId               String
  surveyId             String
  title                String
  systemType           String                      @default("ON_GRID") // ON_GRID, OFF_GRID, HYBRID
  connectionType       String                      @default("THREE_PHASE") // SINGLE_PHASE, THREE_PHASE
  status               String                      @default("DRAFT") // DRAFT, CONFIGURING, CALCULATING, UNDER_REVIEW, APPROVED, REJECTED, SUPERSEDED
  activeRevisionNumber Int                         @default(1)
  sanctionedLoadKw     Decimal?                    @db.Decimal(8, 2)
  targetCapacityKw     Decimal                     @db.Decimal(8, 2)
  createdById          String?
  approvedById         String?
  approvedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?

  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer             Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site                 CustomerSite                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  survey               Survey                      @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  createdBy            User?                       @relation("DesignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy           User?                       @relation("DesignApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  revisions            EngineeringDesignRevision[]
  calculationRuns      CalculationRun[]
  boms                 BillOfMaterials[]
  quotations           Quotation[]
  salesOrders          SalesOrder[]

  @@unique([organizationId, designNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([siteId])
  @@index([surveyId])
  @@index([status])
  @@map("engineering_designs")
}

model EngineeringDesignRevision {
  id                       String            @id @default(uuid())
  organizationId           String
  designId                 String
  revisionNumber           Int
  status                   String            @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED

  // Hardware selections
  panelVariantId           String?
  moduleQuantity           Int               @default(0)
  moduleRatedPowerWatts    Decimal?          @db.Decimal(8, 2)
  totalDcCapacityKw        Decimal           @default(0) @db.Decimal(8, 2)

  inverterVariantId        String?
  inverterQuantity         Int               @default(1)
  inverterRatedPowerKw     Decimal?          @db.Decimal(8, 2)
  totalAcCapacityKw        Decimal           @default(0) @db.Decimal(8, 2)

  batteryVariantId         String?
  batteryQuantity          Int?              @default(0)
  batteryCapacityKwh       Decimal?          @db.Decimal(8, 2)
  backupDurationHours      Decimal?          @db.Decimal(5, 2)
  batterySystemVoltage     Decimal?          @db.Decimal(6, 2)

  structureVariantId       String?
  tiltDegrees              Decimal?          @db.Decimal(5, 2)
  azimuthDegrees           Decimal?          @db.Decimal(5, 2)
  groundClearanceMeters    Decimal?          @db.Decimal(5, 2)

  // Array topology
  stringCount              Int               @default(1)
  modulesPerString         Int               @default(1)
  mpptCount                Int               @default(1)
  mpptAllocations          Json?

  // Calculations snapshot
  dcAcRatio                Decimal?          @db.Decimal(5, 3)
  estDailyGenerationKwh    Decimal?          @db.Decimal(8, 2)
  estAnnualGenerationKwh   Decimal?          @db.Decimal(10, 2)
  specificYieldKwhPerKwp   Decimal?          @db.Decimal(8, 2)
  performanceRatioPercent  Decimal?          @db.Decimal(5, 2)
  co2SavedTonsAnnual       Decimal?          @db.Decimal(6, 2)

  // Electrical sizing snapshot
  dcCableSizeSqMm          Decimal?          @db.Decimal(6, 2)
  acCableSizeSqMm          Decimal?          @db.Decimal(6, 2)
  dcDropPercent            Decimal?          @db.Decimal(4, 2)
  acDropPercent            Decimal?          @db.Decimal(4, 2)
  mainMcbRatingAmps        Decimal?          @db.Decimal(6, 2)
  spdRating                String?
  fuseRatingAmps           Decimal?          @db.Decimal(6, 2)
  earthingRodCount         Int?              @default(2)

  // Compliance & validation
  compatibilityStatus      String            @default("CONDITIONAL") // COMPATIBLE, INCOMPATIBLE, CONDITIONAL
  complianceStatus         String            @default("PASSED") // PASSED, WARNING, FAILED
  validationReport         Json?
  bomGenerated             Boolean           @default(false)

  createdById              String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  design                   EngineeringDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  panelVariant             ProductVariant?   @relation("DesignPanelVariant", fields: [panelVariantId], references: [id], onDelete: SetNull)
  inverterVariant          ProductVariant?   @relation("DesignInverterVariant", fields: [inverterVariantId], references: [id], onDelete: SetNull)
  batteryVariant           ProductVariant?   @relation("DesignBatteryVariant", fields: [batteryVariantId], references: [id], onDelete: SetNull)
  structureVariant         ProductVariant?   @relation("DesignStructureVariant", fields: [structureVariantId], references: [id], onDelete: SetNull)
  createdBy                User?             @relation("RevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([designId, revisionNumber])
  @@index([organizationId])
  @@index([designId])
  @@map("engineering_design_revisions")
}

model CalculationRun {
  id              String            @id @default(uuid())
  organizationId  String
  designId        String
  revisionNumber  Int
  engineVersion   String            @default("2.0.0")
  rulesetVersion  String            @default("MNRE_CEA_2026")
  inputSnapshot   Json
  outputSnapshot  Json
  warnings        Json?
  violations      Json?
  passed          Boolean           @default(true)
  executionTimeMs Int               @default(0)
  executedById    String?
  createdAt       DateTime          @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  design          EngineeringDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  executedBy      User?             @relation("CalculationRunExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([designId])
  @@map("calculation_runs")
}

// =============================================================================
// PHASE 2: BILL OF MATERIALS (BOM)
// =============================================================================

model BillOfMaterials {
  id                String            @id @default(uuid())
  organizationId    String
  bomNumber         String
  designId          String
  revisionNumber    Int
  version           Int               @default(1)
  status            String            @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, REJECTED, FROZEN
  totalMaterialCost Decimal           @default(0) @db.Decimal(12, 2)
  currency          String            @default("INR")
  notes             String?
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  design            EngineeringDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("BOMCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy        User?             @relation("BOMApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items             BOMItem[]
  costEstimates     CostEstimate[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  materialRequirements MaterialRequirement[]

  @@unique([organizationId, bomNumber])
  @@index([organizationId])
  @@index([designId])
  @@index([status])
  @@map("bills_of_materials")
}

model BOMItem {
  id                      String          @id @default(uuid())
  organizationId          String
  bomId                   String
  category                String          // SOLAR_GENERATION, POWER_CONVERSION, STORAGE, MOUNTING, ELECTRICAL_BOS, SERVICES
  variantId               String?
  itemCode                String
  description             String
  quantity                Decimal         @db.Decimal(10, 2)
  uom                     String          @default("NOS") // NOS, METERS, SET, LOT, HOURS
  wastageAllowancePercent Decimal         @default(0) @db.Decimal(5, 2)
  effectiveQuantity       Decimal         @db.Decimal(10, 2)
  unitCost                Decimal         @db.Decimal(12, 2)
  totalCost               Decimal         @db.Decimal(12, 2)
  isOptional              Boolean         @default(false)
  specifications          Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bom                     BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  variant                 ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bomId])
  @@index([category])
  @@map("bom_items")
}

// =============================================================================
// PHASE 2: TAX CONFIGURATION & COMMERCIAL COST ESTIMATES
// =============================================================================

model TaxConfiguration {
  id                       String       @id @default(uuid())
  organizationId           String
  stateCode                String       // MH, DL, KA, etc. or ALL
  solarEquipmentGstPercent Decimal      @default(12.0) @db.Decimal(5, 2)
  servicesGstPercent       Decimal      @default(18.0) @db.Decimal(5, 2)
  isDefault                Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stateCode])
  @@index([organizationId])
  @@map("tax_configurations")
}

model CostEstimate {
  id                      String           @id @default(uuid())
  organizationId          String
  quotationId             String?          @unique
  bomId                   String?
  materialCost            Decimal          @default(0) @db.Decimal(12, 2)
  laborCost               Decimal          @default(0) @db.Decimal(12, 2)
  transportCost           Decimal          @default(0) @db.Decimal(12, 2)
  engineeringServicesCost Decimal          @default(0) @db.Decimal(12, 2)
  statutoryFees           Decimal          @default(0) @db.Decimal(12, 2)
  subtotalCost            Decimal          @default(0) @db.Decimal(12, 2)
  overheadMarginPercent   Decimal          @default(5.0) @db.Decimal(5, 2)
  profitMarginPercent     Decimal          @default(15.0) @db.Decimal(5, 2)
  baseSellingPrice        Decimal          @default(0) @db.Decimal(12, 2)
  discountPercent         Decimal          @default(0) @db.Decimal(5, 2)
  discountAmount          Decimal          @default(0) @db.Decimal(12, 2)
  finalSellingPrice       Decimal          @default(0) @db.Decimal(12, 2)
  isSubsidyEligible       Boolean          @default(true)
  estSubsidyAmount        Decimal          @default(0) @db.Decimal(12, 2)
  netPayableByCustomer    Decimal          @default(0) @db.Decimal(12, 2)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation               Quotation?       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  bom                     BillOfMaterials? @relation(fields: [bomId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bomId])
  @@map("cost_estimates")
}

// =============================================================================
// PHASE 2: QUOTATIONS & PROPOSALS
// =============================================================================

model Quotation {
  id                    String             @id @default(uuid())
  organizationId        String
  quotationNumber       String
  customerId            String
  siteId                String
  designId              String
  bomId                 String
  activeVersionNumber   Int                @default(1)
  status                String             @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, SENT_TO_CUSTOMER, ACCEPTED, REJECTED, EXPIRED, SUPERSEDED
  totalAmount           Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal            @default(0) @db.Decimal(12, 2)
  grandTotal            Decimal            @default(0) @db.Decimal(12, 2)
  subsidyAmount         Decimal            @default(0) @db.Decimal(12, 2)
  netCustomerPayable    Decimal            @default(0) @db.Decimal(12, 2)
  validUntil            DateTime
  scopeOfWork           String
  paymentTerms          Json
  warrantyTerms         String?
  acceptanceDate        DateTime?
  acceptanceMethod      String?            // DIGITAL_SIGNATURE, EMAIL_CONFIRMATION, PHYSICAL_COPY, VERBAL_CONFIRMED
  acceptanceEvidenceUrl String?
  acceptedById          String?
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer              Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site                  CustomerSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  design                EngineeringDesign  @relation(fields: [designId], references: [id], onDelete: Restrict)
  bom                   BillOfMaterials    @relation(fields: [bomId], references: [id], onDelete: Restrict)
  createdBy             User?              @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy            User?              @relation("QuotationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  versions              QuotationVersion[]
  items                 QuotationItem[]
  costEstimate          CostEstimate?
  contracts             Contract[]
  salesOrders           SalesOrder[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([siteId])
  @@index([designId])
  @@index([bomId])
  @@index([status])
  @@map("quotations")
}

model QuotationVersion {
  id                String       @id @default(uuid())
  organizationId    String
  quotationId       String
  versionNumber     Int
  totalAmount       Decimal      @db.Decimal(12, 2)
  taxAmount         Decimal      @db.Decimal(12, 2)
  grandTotal        Decimal      @db.Decimal(12, 2)
  snapshotData      Json
  reasonForRevision String?
  createdById       String?
  createdAt         DateTime     @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation         Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy         User?        @relation("QuotationVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([quotationId, versionNumber])
  @@index([organizationId])
  @@index([quotationId])
  @@map("quotation_versions")
}

model QuotationItem {
  id             String       @id @default(uuid())
  organizationId String
  quotationId    String
  itemCategory   String       // EQUIPMENT, INSTALLATION, ENGINEERING, STATUTORY_LIAISON, BOS
  description    String
  quantity       Decimal      @db.Decimal(10, 2)
  uom            String       @default("NOS")
  unitPrice      Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxPercent     Decimal      @default(13.8) @db.Decimal(5, 2)
  taxAmount      Decimal      @db.Decimal(12, 2)
  totalAmount    Decimal      @db.Decimal(12, 2)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation      Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([quotationId])
  @@map("quotation_items")
}

// =============================================================================
// PHASE 2: CONTRACTS & PAYMENT MILESTONES
// =============================================================================

model Contract {
  id                    String                    @id @default(uuid())
  organizationId        String
  contractNumber        String
  customerId            String
  quotationId           String
  contractDate          DateTime                  @default(now())
  systemCapacityKw      Decimal                   @db.Decimal(8, 2)
  contractAmount        Decimal                   @db.Decimal(12, 2)
  taxAmount             Decimal                   @db.Decimal(12, 2)
  totalContractValue    Decimal                   @db.Decimal(12, 2)
  paymentScheduleType   String                    @default("MILESTONE_BASED") // MILESTONE_BASED, ADVANCE_FULL, CUSTOM
  status                String                    @default("DRAFT") // DRAFT, PENDING_SIGNATURE, ACTIVE, COMPLETED, TERMINATED
  termsAndConditions    String
  signedByCustomerName  String?
  signedDate            DateTime?
  contractDocumentUrl   String?
  createdById           String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotation             Quotation                 @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  createdBy             User?                     @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  milestones            ContractPaymentMilestone[]
  salesOrders           SalesOrder[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([quotationId])
  @@index([status])
  @@map("contracts")
}

model ContractPaymentMilestone {
  id             String       @id @default(uuid())
  organizationId String
  contractId     String
  milestoneType  String       // ADVANCE_BOOKING, MATERIAL_READINESS, DISPATCH, INSTALLATION_COMPLETE, COMMISSIONING_NET_METERING, FINAL_SUBSIDY
  milestoneName  String
  percentage     Decimal      @db.Decimal(5, 2)
  amount         Decimal      @db.Decimal(12, 2)
  status         String       @default("PENDING") // PENDING, INVOICED, PAID, WAIVED
  dueDate        DateTime?
  paidDate       DateTime?
  paidAmount     Decimal      @default(0) @db.Decimal(12, 2)
  referenceNote  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contractId])
  @@map("contract_payment_milestones")
}

// =============================================================================
// PHASE 2: SALES ORDERS & PROJECT INITIATION HANDOFF
// =============================================================================

model SalesOrder {
  id               String                @id @default(uuid())
  organizationId   String
  orderNumber      String
  customerId       String
  contractId       String?
  quotationId      String
  designId         String
  bomId            String
  orderDate        DateTime              @default(now())
  totalAmount      Decimal               @db.Decimal(12, 2)
  advanceRequired  Decimal               @db.Decimal(12, 2)
  advanceReceived  Decimal               @default(0) @db.Decimal(12, 2)
  status           String                @default("DRAFT") // DRAFT, CONFIRMED, IN_EXECUTION, ON_HOLD, COMPLETED, CANCELLED
  fulfillmentStatus String               @default("NOT_STARTED") // NOT_STARTED, PROCUREMENT, ALLOCATED, DISPATCHED, INSTALLED, COMMISSIONED
  paymentStatus    String                @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  prerequisitesMet Boolean               @default(false)
  confirmedAt      DateTime?
  confirmedById    String?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contract         Contract?             @relation(fields: [contractId], references: [id], onDelete: SetNull)
  quotation        Quotation             @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  design           EngineeringDesign     @relation(fields: [designId], references: [id], onDelete: Restrict)
  bom              BillOfMaterials       @relation(fields: [bomId], references: [id], onDelete: Restrict)
  createdBy        User?                 @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy      User?                 @relation("SalesOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  milestones       SalesOrderMilestone[]
  projectInitiation ProjectInitiation?
  materialRequirements MaterialRequirement[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([contractId])
  @@index([quotationId])
  @@index([designId])
  @@index([bomId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderMilestone {
  id             String       @id @default(uuid())
  organizationId String
  salesOrderId   String
  milestoneType  String
  name           String
  percentage     Decimal      @db.Decimal(5, 2)
  amount         Decimal      @db.Decimal(12, 2)
  isPaid         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([salesOrderId])
  @@map("sales_order_milestones")
}

model ProjectInitiation {
  id                String            @id @default(uuid())
  organizationId    String
  salesOrderId      String            @unique
  projectCode       String
  projectName       String
  customerId        String
  siteId            String
  systemCapacityKw  Decimal           @db.Decimal(8, 2)
  systemType        String            @default("ON_GRID")
  bomSnapshot       Json
  designSnapshot    Json
  handoverStatus    String            @default("READY_FOR_PROCUREMENT") // READY_FOR_PROCUREMENT, PROCUREMENT_PENDING, HANDED_OVER
  handedOverAt      DateTime          @default(now())
  initiatedById     String
  createdAt         DateTime          @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder        SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site              CustomerSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  initiatedBy       User              @relation("ProjectInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  materialRequirements MaterialRequirement[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]

  @@unique([organizationId, projectCode])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([siteId])
  @@map("project_initiations")
}

// =============================================================================
// PHASE 3: SUPPLIER MANAGEMENT, MRP, RFQ, PO, GRN, QUALITY & SERIAL TRACKING
// =============================================================================

model Supplier {
  id                String                   @id @default(uuid())
  organizationId    String
  supplierCode      String
  legalName         String
  tradeName         String?
  category          String                   @default("DISTRIBUTOR") // MANUFACTURER, DISTRIBUTOR, WHOLESALER, IMPORTER, SERVICE_PROVIDER
  supplierType      String                   @default("SOLAR_PANELS") // SOLAR_PANELS, INVERTERS, BATTERIES, BOS, STRUCTURE, ELECTRICAL, GENERAL
  gstin             String?
  pan               String?
  msmeNumber        String?
  status            String                   @default("ACTIVE") // PROSPECTIVE, ACTIVE, ON_HOLD, BLACKLISTED
  paymentTerms      String                   @default("NET_30") // ADVANCE, NET_15, NET_30, NET_45, NET_60, LC, PDC
  creditPeriodDays  Int                      @default(30)
  creditLimit       Decimal                  @default(0) @db.Decimal(14, 2)
  currency          String                   @default("INR")
  rating            Decimal?                 @db.Decimal(3, 2)
  notes             String?
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts          SupplierContact[]
  addresses         SupplierAddress[]
  bankAccounts      SupplierBankAccount[]
  documents         SupplierDocument[]
  productMappings   SupplierProductMapping[]
  priceHistories    SupplierPriceHistory[]
  rfqSuppliers      RFQSupplier[]
  quotations        SupplierQuotation[]
  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  supplierReturns   SupplierReturn[]

  @@unique([organizationId, supplierCode])
  @@index([organizationId])
  @@index([category])
  @@index([supplierType])
  @@index([status])
  @@index([gstin])
  @@map("suppliers")
}

model SupplierContact {
  id             String       @id @default(uuid())
  organizationId String
  supplierId     String
  name           String
  designation    String?
  department     String?
  email          String?
  phone          String
  alternatePhone String?
  isPrimary      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
  @@map("supplier_contacts")
}

model SupplierAddress {
  id             String       @id @default(uuid())
  organizationId String
  supplierId     String
  type           String       @default("BILLING") // REGISTERED, FACTORY, WAREHOUSE, BILLING, DISPATCH
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  postalCode     String
  country        String       @default("IN")
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
  @@map("supplier_addresses")
}

model SupplierBankAccount {
  id             String       @id @default(uuid())
  organizationId String
  supplierId     String
  bankName       String
  accountNumber  String
  ifscCode       String
  branchName     String?
  accountType    String       @default("CURRENT") // CURRENT, SAVINGS
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
  @@map("supplier_bank_accounts")
}

model SupplierDocument {
  id             String       @id @default(uuid())
  organizationId String
  supplierId     String
  documentType   String       // GST_CERTIFICATE, PAN_CARD, MSME_CERTIFICATE, CANCELLED_CHEQUE, ISO_CERTIFICATE, DEALERSHIP_CERTIFICATE, OTHER
  documentNumber String?
  fileUrl        String
  fileName       String
  fileSizeBytes  Int?
  mimeType       String?
  expiryDate     DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
  @@index([documentType])
  @@map("supplier_documents")
}

model SupplierProductMapping {
  id                   String                 @id @default(uuid())
  organizationId       String
  supplierId           String
  productVariantId     String
  supplierPartCode     String?
  supplierPartName     String?
  leadTimeDays         Int                    @default(7)
  minimumOrderQuantity Decimal                @default(1) @db.Decimal(10, 2)
  unitPrice            Decimal                @db.Decimal(12, 2)
  taxRatePercent       Decimal                @default(18) @db.Decimal(5, 2)
  isPreferred          Boolean                @default(false)
  currency             String                 @default("INR")
  effectiveFrom        DateTime               @default(now())
  effectiveTo          DateTime?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productVariant       ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  priceHistories       SupplierPriceHistory[]

  @@unique([organizationId, supplierId, productVariantId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([productVariantId])
  @@map("supplier_product_mappings")
}

model SupplierPriceHistory {
  id                       String                  @id @default(uuid())
  organizationId           String
  supplierProductMappingId String?
  supplierId               String
  productVariantId         String
  oldPrice                 Decimal                 @db.Decimal(12, 2)
  newPrice                 Decimal                 @db.Decimal(12, 2)
  currency                 String                  @default("INR")
  effectiveDate            DateTime                @default(now())
  reason                   String?
  changedById              String?
  createdAt                DateTime                @default(now())

  organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mapping                  SupplierProductMapping? @relation(fields: [supplierProductMappingId], references: [id], onDelete: SetNull)
  supplier                 Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productVariant           ProductVariant          @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  changedBy                User?                   @relation("PriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([supplierId])
  @@index([productVariantId])
  @@map("supplier_price_history")
}

model MaterialRequirement {
  id                   String                    @id @default(uuid())
  organizationId       String
  requirementNumber    String
  title                String
  projectInitiationId  String?
  salesOrderId         String?
  bomId                String?
  status               String                    @default("DRAFT") // DRAFT, CALCULATED, CONVERTED_TO_PR, CANCELLED
  totalItems           Int                       @default(0)
  estimatedTotalAmount Decimal                   @default(0) @db.Decimal(14, 2)
  plannedDate          DateTime?
  createdById          String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectInitiation    ProjectInitiation?        @relation(fields: [projectInitiationId], references: [id], onDelete: SetNull)
  salesOrder           SalesOrder?               @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  bom                  BillOfMaterials?          @relation(fields: [bomId], references: [id], onDelete: SetNull)
  createdBy            User?                     @relation("RequirementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines                MaterialRequirementLine[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([organizationId, requirementNumber])
  @@index([organizationId])
  @@index([projectInitiationId])
  @@index([salesOrderId])
  @@index([status])
  @@map("material_requirements")
}

model MaterialRequirementLine {
  id                     String              @id @default(uuid())
  organizationId         String
  materialRequirementId  String
  productVariantId       String
  category               String?             // SOLAR_PANEL, INVERTER, BATTERY, STRUCTURE, BOS_ELECTRICAL, FASTENERS, SAFETY
  requiredQuantity       Decimal             @db.Decimal(10, 2)
  existingStockQuantity  Decimal             @default(0) @db.Decimal(10, 2)
  allocatedStockQuantity Decimal             @default(0) @db.Decimal(10, 2)
  netProcurementQuantity Decimal             @db.Decimal(10, 2)
  estimatedUnitCost      Decimal             @db.Decimal(12, 2)
  estimatedTotalCost     Decimal             @db.Decimal(12, 2)
  unitOfMeasure          String              @default("PCS")
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  materialRequirement    MaterialRequirement @relation(fields: [materialRequirementId], references: [id], onDelete: Cascade)
  productVariant         ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([materialRequirementId])
  @@index([productVariantId])
  @@map("material_requirement_lines")
}

model PurchaseRequisition {
  id                    String                    @id @default(uuid())
  organizationId        String
  requisitionNumber     String
  title                 String
  purpose               String                    @default("PROJECT_SPECIFIC") // PROJECT_SPECIFIC, STOCK_REPLENISHMENT, EMERGENCY
  status                String                    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, RFQ_GENERATED, PARTIALLY_ORDERED, ORDERED, CANCELLED
  priority              String                    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  requiredByDate        DateTime?
  projectInitiationId   String?
  salesOrderId          String?
  materialRequirementId String?
  requestedById         String?
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?
  totalEstimatedAmount  Decimal                   @default(0) @db.Decimal(14, 2)
  notes                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectInitiation     ProjectInitiation?        @relation(fields: [projectInitiationId], references: [id], onDelete: SetNull)
  salesOrder            SalesOrder?               @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  materialRequirement   MaterialRequirement?      @relation(fields: [materialRequirementId], references: [id], onDelete: SetNull)
  requestedBy           User?                     @relation("RequisitionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy            User?                     @relation("RequisitionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines                 PurchaseRequisitionLine[]
  rfqs                  RFQ[]
  purchaseOrders        PurchaseOrder[]

  @@unique([organizationId, requisitionNumber])
  @@index([organizationId])
  @@index([projectInitiationId])
  @@index([salesOrderId])
  @@index([status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                    String              @id @default(uuid())
  organizationId        String
  purchaseRequisitionId String
  productVariantId      String
  requestedQuantity     Decimal             @db.Decimal(10, 2)
  approvedQuantity      Decimal             @default(0) @db.Decimal(10, 2)
  orderedQuantity       Decimal             @default(0) @db.Decimal(10, 2)
  estimatedUnitCost     Decimal             @db.Decimal(12, 2)
  estimatedTotalCost    Decimal             @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequisition   PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  productVariant        ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([purchaseRequisitionId])
  @@index([productVariantId])
  @@map("purchase_requisition_lines")
}

model RFQ {
  id                  String              @id @default(uuid())
  organizationId      String
  rfqNumber           String
  title               String
  requisitionId       String?
  status              String              @default("DRAFT") // DRAFT, ISSUED, RESPONSES_RECEIVED, UNDER_EVALUATION, AWARDED, CANCELLED
  issueDate           DateTime            @default(now())
  dueDate             DateTime
  awardedSupplierId   String?
  termsAndConditions  String?
  notes               String?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requisition         PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation("RFQCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines               RFQLine[]
  suppliers           RFQSupplier[]
  quotations          SupplierQuotation[]

  @@unique([organizationId, rfqNumber])
  @@index([organizationId])
  @@index([requisitionId])
  @@index([status])
  @@map("rfqs")
}

model RFQLine {
  id                String                  @id @default(uuid())
  organizationId    String
  rfqId             String
  productVariantId  String
  targetQuantity    Decimal                 @db.Decimal(10, 2)
  targetUnitPrice   Decimal?                @db.Decimal(12, 2)
  targetDeliveryDate DateTime?
  specifications    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq               RFQ                     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant          @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  quotationLines    SupplierQuotationLine[]

  @@index([organizationId])
  @@index([rfqId])
  @@index([productVariantId])
  @@map("rfq_lines")
}

model RFQSupplier {
  id               String       @id @default(uuid())
  organizationId   String
  rfqId            String
  supplierId       String
  invitationStatus String       @default("INVITED") // INVITED, ACKNOWLEDGED, DECLINED, QUOTED
  invitedAt        DateTime     @default(now())
  respondedAt      DateTime?
  notes            String?
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq              RFQ          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier         Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([organizationId, rfqId, supplierId])
  @@index([organizationId])
  @@index([rfqId])
  @@index([supplierId])
  @@map("rfq_suppliers")
}

model SupplierQuotation {
  id                    String                  @id @default(uuid())
  organizationId        String
  quotationNumber       String
  rfqId                 String?
  supplierId            String
  supplierQuoteReference String?
  quotationDate         DateTime                @default(now())
  validUntilDate        DateTime
  currency              String                  @default("INR")
  subtotalAmount        Decimal                 @db.Decimal(14, 2)
  taxAmount             Decimal                 @db.Decimal(14, 2)
  freightCharges        Decimal                 @default(0) @db.Decimal(12, 2)
  otherCharges          Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal                 @db.Decimal(14, 2)
  deliveryLeadTimeDays  Int                     @default(7)
  paymentTerms          String                  @default("NET_30")
  warrantyTerms         String?
  status                String                  @default("RECEIVED") // RECEIVED, UNDER_REVIEW, ACCEPTED, REJECTED, EXPIRED
  comparisonRank        Int?
  isWinning             Boolean                 @default(false)
  notes                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq                   RFQ?                    @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  supplier              Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines                 SupplierQuotationLine[]
  purchaseOrders        PurchaseOrder[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([rfqId])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_quotations")
}

model SupplierQuotationLine {
  id                   String            @id @default(uuid())
  organizationId       String
  supplierQuotationId  String
  rfqLineId            String?
  productVariantId     String
  quotedQuantity       Decimal           @db.Decimal(10, 2)
  unitPrice            Decimal           @db.Decimal(12, 2)
  taxRatePercent       Decimal           @default(18) @db.Decimal(5, 2)
  taxAmount            Decimal           @db.Decimal(12, 2)
  totalPrice           Decimal           @db.Decimal(12, 2)
  deliveryLeadTimeDays Int?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierQuotation    SupplierQuotation @relation(fields: [supplierQuotationId], references: [id], onDelete: Cascade)
  rfqLine              RFQLine?          @relation(fields: [rfqLineId], references: [id], onDelete: SetNull)
  productVariant       ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([supplierQuotationId])
  @@index([productVariantId])
  @@map("supplier_quotation_lines")
}

model PurchaseOrder {
  id                   String                     @id @default(uuid())
  organizationId       String
  poNumber             String
  version              Int                        @default(1)
  originalPoId         String?
  requisitionId        String?
  quotationId          String?
  supplierId           String
  projectInitiationId  String?
  salesOrderId         String?
  status               String                     @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, ISSUED, ACKNOWLEDGED, PARTIALLY_RECEIVED, FULLY_RECEIVED, CANCELLED, CLOSED
  approvalStatus       String                     @default("PENDING") // PENDING, APPROVED, REJECTED
  orderDate            DateTime                   @default(now())
  expectedDeliveryDate DateTime
  billingAddress       Json?
  shippingAddress      Json?
  currency             String                     @default("INR")
  subtotalAmount       Decimal                    @db.Decimal(14, 2)
  taxAmount            Decimal                    @db.Decimal(14, 2)
  freightAmount        Decimal                    @default(0) @db.Decimal(12, 2)
  roundOff             Decimal                    @default(0) @db.Decimal(6, 2)
  totalAmount          Decimal                    @db.Decimal(14, 2)
  paymentTerms         String                     @default("NET_30")
  termsAndConditions   String?
  notes                String?
  versionComments      String?
  createdById          String?
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originalPo           PurchaseOrder?             @relation("PurchaseOrderRevisions", fields: [originalPoId], references: [id], onDelete: SetNull)
  revisions            PurchaseOrder[]            @relation("PurchaseOrderRevisions")
  requisition          PurchaseRequisition?       @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  quotation            SupplierQuotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  supplier             Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  projectInitiation    ProjectInitiation?         @relation(fields: [projectInitiationId], references: [id], onDelete: SetNull)
  salesOrder           SalesOrder?                @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  createdBy            User?                      @relation("POCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy           User?                      @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines                PurchaseOrderLine[]
  deliverySchedules    PurchaseDeliverySchedule[]
  goodsReceiptNotes    GoodsReceiptNote[]
  supplierReturns      SupplierReturn[]

  @@unique([organizationId, poNumber, version])
  @@index([organizationId])
  @@index([supplierId])
  @@index([projectInitiationId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String                     @id @default(uuid())
  organizationId    String
  purchaseOrderId   String
  productVariantId  String
  itemDescription   String?
  hsnCode           String?
  orderedQuantity   Decimal                    @db.Decimal(10, 2)
  receivedQuantity  Decimal                    @default(0) @db.Decimal(10, 2)
  acceptedQuantity  Decimal                    @default(0) @db.Decimal(10, 2)
  rejectedQuantity  Decimal                    @default(0) @db.Decimal(10, 2)
  unitPrice         Decimal                    @db.Decimal(12, 2)
  discountPercent   Decimal                    @default(0) @db.Decimal(5, 2)
  taxRatePercent    Decimal                    @default(18) @db.Decimal(5, 2)
  taxAmount         Decimal                    @db.Decimal(12, 2)
  totalAmount       Decimal                    @db.Decimal(14, 2)
  expectedDate      DateTime?
  isFullyReceived   Boolean                    @default(false)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant             @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  deliverySchedules PurchaseDeliverySchedule[]
  goodsReceiptLines GoodsReceiptLine[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([productVariantId])
  @@map("purchase_order_lines")
}

model PurchaseDeliverySchedule {
  id                 String            @id @default(uuid())
  organizationId     String
  purchaseOrderId    String
  purchaseOrderLineId String
  scheduledQuantity  Decimal           @db.Decimal(10, 2)
  scheduledDate      DateTime
  receivedQuantity   Decimal           @default(0) @db.Decimal(10, 2)
  status             String            @default("PENDING") // PENDING, IN_TRANSIT, RECEIVED, DELAYED, CANCELLED
  trackingReference  String?
  courierTransporter String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder      PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderLine  PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([purchaseOrderLineId])
  @@map("purchase_delivery_schedules")
}

model InventoryLocation {
  id                 String                    @id @default(uuid())
  organizationId     String
  code               String
  name               String
  type               String                    @default("MAIN_WAREHOUSE") // RECEIVING_BAY, MAIN_WAREHOUSE, INSPECTION_ZONE, QUARANTINE, PROJECT_STAGING, DAMAGED_GOODS
  address            String?
  isDefaultReceiving Boolean                   @default(false)
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceipts      GoodsReceiptNote[]
  fromMovements      InventoryReceiptMovement[] @relation("MovementFromLocation")
  toMovements        InventoryReceiptMovement[] @relation("MovementToLocation")
  serials            ProductSerial[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@map("inventory_locations")
}

model GoodsReceiptNote {
  id                    String                     @id @default(uuid())
  organizationId        String
  grnNumber             String
  purchaseOrderId       String
  supplierId            String
  supplierInvoiceNumber String?
  supplierInvoiceDate   DateTime?
  supplierChallanNumber String?
  supplierChallanDate   DateTime?
  gatePassNumber        String?
  vehicleNumber         String?
  transporterName       String?
  lrNumber              String?
  receivedDate          DateTime                   @default(now())
  status                String                     @default("DRAFT") // DRAFT, RECEIVED_AT_GATE, INSPECTION_PENDING, INSPECTED, PARTIALLY_ACCEPTED, FULLY_ACCEPTED, REJECTED, STOCKED
  receivedById          String?
  receivedLocationId    String?
  remarks               String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder         PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier              Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivedBy            User?                      @relation("GRNReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedLocation      InventoryLocation?         @relation(fields: [receivedLocationId], references: [id], onDelete: SetNull)
  lines                 GoodsReceiptLine[]
  qualityInspections    QualityInspection[]
  serials               ProductSerial[]
  supplierReturns       SupplierReturn[]

  @@unique([organizationId, grnNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  @@map("goods_receipt_notes")
}

model GoodsReceiptLine {
  id                 String              @id @default(uuid())
  organizationId     String
  goodsReceiptNoteId String
  purchaseOrderLineId String
  productVariantId   String
  challanQuantity    Decimal             @db.Decimal(10, 2)
  receivedQuantity   Decimal             @db.Decimal(10, 2)
  acceptedQuantity   Decimal             @default(0) @db.Decimal(10, 2)
  rejectedQuantity   Decimal             @default(0) @db.Decimal(10, 2)
  shortageQuantity   Decimal             @default(0) @db.Decimal(10, 2)
  damagedQuantity    Decimal             @default(0) @db.Decimal(10, 2)
  excessQuantity     Decimal             @default(0) @db.Decimal(10, 2)
  unitCost           Decimal             @db.Decimal(12, 2)
  inspectionStatus   String              @default("PENDING") // PENDING, PASSED, REJECTED, CONDITIONAL_PASS
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceiptNote   GoodsReceiptNote    @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Cascade)
  purchaseOrderLine  PurchaseOrderLine   @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  productVariant     ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  qualityInspections QualityInspection[]
  serials            ProductSerial[]
  supplierReturnLines SupplierReturnLine[]

  @@index([organizationId])
  @@index([goodsReceiptNoteId])
  @@index([productVariantId])
  @@map("goods_receipt_lines")
}

model QualityInspection {
  id                     String            @id @default(uuid())
  organizationId         String
  inspectionNumber       String
  goodsReceiptNoteId     String
  goodsReceiptLineId     String
  productVariantId       String
  inspectionType         String            @default("COMPLETE") // VISUAL, ELECTRICAL, DIMENSIONAL, COMPLETE
  totalInspectedQuantity Decimal           @db.Decimal(10, 2)
  passedQuantity         Decimal           @db.Decimal(10, 2)
  rejectedQuantity       Decimal           @db.Decimal(10, 2)
  conditionalQuantity    Decimal           @default(0) @db.Decimal(10, 2)
  overallOutcome         String            @default("PASS") // PASS, FAIL, CONDITIONAL_PASS
  checklistResults       Json              // Array of check item objects: { item, result, criteria, notes }
  measurements           Json?             // Solar specific: { voc, isc, vmp, imp, pmax, elReportRef, etc. }
  photoEvidenceUrls      String[]          @default([])
  rejectionReasons       String[]          @default([])
  actionRecommended      String            @default("ACCEPT") // ACCEPT, REJECT_TO_VENDOR, SORT_AND_USE, REWORK
  inspectedById          String?
  inspectedAt            DateTime          @default(now())
  inspectorNotes         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceiptNote       GoodsReceiptNote  @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Cascade)
  goodsReceiptLine       GoodsReceiptLine  @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)
  productVariant         ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inspectedBy            User?             @relation("InspectionPerformedBy", fields: [inspectedById], references: [id], onDelete: SetNull)
  serials                ProductSerial[]

  @@unique([organizationId, inspectionNumber])
  @@index([organizationId])
  @@index([goodsReceiptNoteId])
  @@index([productVariantId])
  @@index([overallOutcome])
  @@map("quality_inspections")
}

model ProductSerial {
  id                       String             @id @default(uuid())
  organizationId           String
  productVariantId         String
  goodsReceiptNoteId       String
  goodsReceiptLineId       String?
  inspectionId             String?
  manufacturerSerialNumber String
  internalAssetCode        String
  barcode                  String?
  qrCode                   String?
  batchNumber              String?
  status                   String             @default("IN_STOCK") // RECEIVED, INSPECTED, IN_STOCK, ALLOCATED, DISPATCHED, INSTALLED, UNDER_REPAIR, RETURNED_TO_VENDOR, RETIRED
  storageLocationId        String?
  electricalSpecs          Json?              // { voc, isc, vmp, imp, pmax, efficiency, flashTestData }
  warrantyPeriodMonths     Int                @default(60)
  warrantyExpiresAt        DateTime?
  commissionedAt           DateTime?
  registeredById           String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVariant           ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  goodsReceiptNote         GoodsReceiptNote   @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Cascade)
  goodsReceiptLine         GoodsReceiptLine?  @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)
  qualityInspection        QualityInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  storageLocation          InventoryLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  registeredBy             User?              @relation("SerialRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)

  @@unique([organizationId, manufacturerSerialNumber, productVariantId])
  @@unique([organizationId, internalAssetCode])
  @@index([organizationId])
  @@index([productVariantId])
  @@index([goodsReceiptNoteId])
  @@index([status])
  @@index([batchNumber])
  @@map("product_serials")
}

model InventoryReceiptMovement {
  id             String             @id @default(uuid())
  organizationId String
  movementNumber String
  movementType   String             // PURCHASE_RECEIPT, QUALITY_REJECT, SUPPLIER_RETURN, INTERNAL_TRANSFER
  productVariantId String
  fromLocationId String?
  toLocationId   String?
  quantity       Decimal            @db.Decimal(10, 2)
  unitCost       Decimal            @db.Decimal(12, 2)
  totalValue     Decimal            @db.Decimal(14, 2)
  referenceType  String             // GRN, PO, RETURN, REQUISITION
  referenceId    String
  batchNumber    String?
  notes          String?
  createdById    String?
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVariant ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  fromLocation   InventoryLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     InventoryLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, movementNumber])
  @@index([organizationId])
  @@index([productVariantId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("inventory_receipt_movements")
}

model SupplierReturn {
  id                 String               @id @default(uuid())
  organizationId     String
  returnNumber       String
  supplierId         String
  goodsReceiptNoteId String?
  purchaseOrderId    String?
  status             String               @default("DRAFT") // DRAFT, SUBMITTED, APPROVED_BY_SUPPLIER, DISPATCHED, CREDIT_NOTE_RECEIVED, REPLACEMENT_RECEIVED, CLOSED, CANCELLED
  returnType         String               @default("DEFECTIVE_REJECTION") // DEFECTIVE_REJECTION, EXCESS_DELIVERY, WRONG_ITEM, WARRANTY_CLAIM
  totalReturnAmount  Decimal              @default(0) @db.Decimal(14, 2)
  dispatchDate       DateTime?
  transporterDetails Json?
  debitNoteNumber    String?
  creditNoteNumber   String?
  reason             String
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier           Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  goodsReceiptNote   GoodsReceiptNote?    @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: SetNull)
  purchaseOrder      PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy          User?                @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines              SupplierReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id                 String            @id @default(uuid())
  organizationId     String
  supplierReturnId   String
  productVariantId   String
  goodsReceiptLineId String?
  returnedQuantity   Decimal           @db.Decimal(10, 2)
  unitPrice          Decimal           @db.Decimal(12, 2)
  totalAmount        Decimal           @db.Decimal(14, 2)
  serialNumbers      String[]          @default([])
  reason             String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierReturn     SupplierReturn    @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  productVariant     ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([supplierReturnId])
  @@index([productVariantId])
  @@map("supplier_return_lines")
}
