# ==============================================================================
# SOLAROS ERP — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local or production environment.
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Application URLs
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres_local_password@localhost:5432/solaros_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (MinIO / S3) Configuration
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DOCUMENTS=solaros-documents
STORAGE_BUCKET_SURVEYS=solaros-surveys

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_must_be_changed_in_production_min_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=super_secret_cookie_signing_key_32_chars
SESSION_SECRET=super_secret_session_encryption_key_32_chars

# Logging & Observability
LOG_LEVEL=debug
ENABLE_SWAGGER=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
